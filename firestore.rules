rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'photoURL'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && data.role in ['doctor', 'clinician', 'patient', 'admin']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'affectedSide', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.affectedSide in ['right', 'left', 'bilateral']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('gender' in data) || data.gender in ['male', 'female', 'other'])
        && (!('age' in data) || data.age is number)
        && (!('onsetDays' in data) || data.onsetDays is number)
        && (!('houseBrackmannScale' in data) || data.houseBrackmannScale is number)
        && (!('sunnybrookScore' in data) || data.sunnybrookScore is number)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTherapySession(data) {
      return data.keys().hasAll(['id', 'patientId', 'userId', 'sessionDate', 'protocol', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.patientId is string && data.patientId.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.sessionDate is string && data.sessionDate.size() <= 64
        && data.protocol is string && data.protocol.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('durationMinutes' in data) || data.durationMinutes is number)
        && (!('tensIntensityMa' in data) || data.tensIntensityMa is number)
        && (!('laserDoseJoule' in data) || data.laserDoseJoule is number)
        && (!('facialSymmetryBefore' in data) || data.facialSymmetryBefore is number)
        && (!('facialSymmetryAfter' in data) || data.facialSymmetryAfter is number)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('targetBranches' in data) || data.targetBranches is list)
        && (!('motorPoints' in data) || data.motorPoints is list);
    }

    function isValidAssessment(data) {
      return data.keys().hasAll(['id', 'patientId', 'userId', 'date', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.patientId is string && data.patientId.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.date is string && data.date.size() <= 64
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('restingSymmetry' in data) || data.restingSymmetry is number)
        && (!('voluntaryMovementScore' in data) || data.voluntaryMovementScore is number)
        && (!('synkinesisScore' in data) || data.synkinesisScore is number)
        && (!('totalScore' in data) || data.totalScore is number)
        && (!('recommendedProtocol' in data) || (data.recommendedProtocol is string && data.recommendedProtocol.size() <= 128))
        && (!('findings' in data) || (data.findings is string && data.findings.size() <= 2000));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection: no listing users
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Patients Collection
    match /patients/{patientId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(patientId) && isValidPatient(incoming())
        && incoming().id == patientId;
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidPatient(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // Therapy Sessions Collection
    match /therapy_sessions/{sessionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId) && isValidTherapySession(incoming())
        && incoming().id == sessionId;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidTherapySession(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Assessments Collection
    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(assessmentId) && isValidAssessment(incoming())
        && incoming().id == assessmentId;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidAssessment(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
